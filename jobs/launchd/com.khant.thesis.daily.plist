<plist version="1.0"><dict>
  <key>Label</key><string>com.khant.thesis.daily</string>
  <key>ProgramArguments</key><array><string>/bin/bash</string><string>/Users/mac/thesis-collectors/run_daily.sh</string></array>
  <key>WorkingDirectory</key><string>/Users/mac/thesis-collectors</string>
  <key>StartCalendarInterval</key><dict><key>Hour</key><integer>21</integer><key>Minute</key><integer>0</integer></dict>
  <key>StandardOutPath</key><string>/Users/mac/thesis-collectors/logs/daily.log</string>
